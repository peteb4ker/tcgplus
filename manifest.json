{
  "manifest_version": 3,
  "name": "TCGPlus",
  "version": "0.2.0",
  "description": "Usability improvements for TCGplayer: vendor locations, market-price chips, click-to-filter by region, and configurable hide controls.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options/index.html",
  "action": {
    "default_title": "Open TCGPlus settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tcgplayer.com/product/*", "https://www.tcgplayer.com/search/*"],
      "js": ["lib.js", "storage.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://seller-stores-backend.tcgplayer.com/*", "https://mpgateway.tcgplayer.com/*"]
}
