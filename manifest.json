{
  "manifest_version": 3,
  "name": "TCGPlus – TCGplayer Deal Finder & Seller Location",
  "short_name": "TCGPlus",
  "version": "0.3.0",
  "description": "Compares each TCGplayer listing to market price, shows shipping and seller location, and marks the deals. Free and open source.",
  "homepage_url": "https://github.com/peteb4ker/tcgplus",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options/index.html",
  "action": {
    "default_title": "Open TCGPlus settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tcgplayer.com/*"],
      "js": ["lib.js", "storage.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://seller-stores-backend.tcgplayer.com/*",
    "https://mpgateway.tcgplayer.com/*",
    "https://mp-search-api.tcgplayer.com/*"
  ]
}
