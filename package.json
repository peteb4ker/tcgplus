{
  "name": "tcgplus",
  "version": "0.7.0",
  "private": true,
  "description": "Compares each TCGplayer listing to market price, shows shipping and seller location, and marks the deals. Free and open source.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "release": "node tools/bump-version.js",
    "dev:build": "node tools/build-dev.js",
    "demo:record": "node tools/record-demo.js",
    "audit:selectors": "node tools/audit-selectors.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
